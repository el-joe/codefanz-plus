# =====================================================================================================================
# CodeFanz — production environment template. Copy to {{APP_PATH}}/shared/.env (owner {{APP_USER}}, chmod 640) and
# fill in every value marked CHANGE. NEVER commit the real file. Integration credentials (payment gateways, AI
# providers, social apps, Telegram, Google, n8n) are NOT env vars: enter them in Admin → Settings, where they are
# stored encrypted with APP_KEY. Lists every variable the application reads (tests/Unit/ProductionEnvTemplateTest).
# After any change: php artisan optimize (config is cached) and php artisan queue:restart.
# Verify with: php artisan app:check-production
# Lines like `# KEY=` are listed for completeness and stay UNSET on purpose: an empty value would replace the
# framework default with "" (uncomment only when you set a real value).
# =====================================================================================================================

# --- Application -----------------------------------------------------------------------------------------------------
APP_NAME=CodeFanz
APP_ENV=production
# Generated ONCE on the server: php artisan key:generate --show → paste here. Back it up off the server: losing it
# makes every encrypted setting, session and 2FA secret unreadable. To rotate, move the old key to APP_PREVIOUS_KEYS.
APP_KEY=
APP_PREVIOUS_KEYS=
# Never true on a public host: debug pages expose configuration, queries and stack traces.
APP_DEBUG=false
# Canonical https origin, no trailing slash. Used for links in mail, signed URLs, OAuth callbacks, sitemaps.
APP_URL=https://{{DOMAIN}}
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# `file` works with the release-directory layout (storage/framework/down lives in shared/storage).
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# --- Logging ---------------------------------------------------------------------------------------------------------
# Daily files storage/logs/laravel-YYYY-MM-DD.log, pruned after LOG_DAILY_DAYS. Add `slack` for alerts:
# LOG_STACK=daily,slack (Slack incoming webhook; LOG_SLACK_LEVEL=critical sends only critical/alert/emergency).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
# LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME=CodeFanz
LOG_SLACK_EMOJI=:rotating_light:
LOG_SLACK_LEVEL=critical
# Unused channels (framework defaults): papertrail, stderr, syslog
# LOG_PAPERTRAIL_HANDLER=
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=

# --- Database (MySQL 8, utf8mb4) ---------------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{DB_NAME}}
DB_USERNAME=codefanz
# CHANGE: long random password; the app user needs only privileges on this one schema.
DB_PASSWORD=
# DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# DB_URL=
# Only for a remote / managed MySQL with TLS: path to the CA bundle.
# MYSQL_ATTR_SSL_CA=
# Unused by MySQL (framework defaults for other drivers)
DB_FOREIGN_KEYS=true
# DB_SSLMODE=
# DB_ENCRYPT=
# DB_TRUST_SERVER_CERTIFICATE=

# --- Sessions ----------------------------------------------------------------------------------------------------------
# database works out of the box; `redis` is faster when Redis is installed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# SESSION_COOKIE=   (default: <app-name>-session)
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
# null = the exact host of APP_URL (recommended; do not share cookies with subdomains).
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
# SESSION_CONNECTION=
SESSION_TABLE=sessions
# SESSION_STORE=

# --- Cache -------------------------------------------------------------------------------------------------------------
# Recommended: redis (phpredis extension; no Composer package needed). `database` also works (one query per key).
# Never `array` in production (rate limits and the scheduler heartbeat would not persist).
CACHE_STORE=database
CACHE_PREFIX=codefanz-cache-
# DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=
# CACHE_STORAGE_DISK=
CACHE_STORAGE_PATH=framework/cache/data
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

# --- Queue -------------------------------------------------------------------------------------------------------------
# database (works everywhere) or redis (lower latency). Never sync: Supervisor workers run media, social and webhooks.
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
# DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
# Must exceed the longest job timeout (SEO audit crawl: 1800 s), or long jobs are run twice.
DB_QUEUE_RETRY_AFTER=1900
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=1900

# --- Redis (optional) ------------------------------------------------------------------------------------------------
# apt install redis-server php8.3-redis. Bind to 127.0.0.1, set requirepass, and use phpredis (predis is not installed).
REDIS_CLIENT=phpredis
# REDIS_URL=
REDIS_HOST=127.0.0.1
# REDIS_USERNAME=
# REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=codefanz-database-
REDIS_CLUSTER=redis
REDIS_PERSISTENT=false
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

# --- Mail --------------------------------------------------------------------------------------------------------------
# CHANGE: real SMTP (or ses / postmark / resend). `log` / `array` fail app:check-production. Mail is sent during the
# request (notifications are not queued), so use a fast, nearby SMTP relay. Set SPF, DKIM and DMARC for the domain.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
# MAIL_URL=
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN={{DOMAIN}}
MAIL_FROM_ADDRESS=hello@{{DOMAIN}}
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_LOG_CHANNEL=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# Only when MAIL_MAILER is postmark / resend / ses:
# POSTMARK_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=
# RESEND_API_KEY=
# Shown on error pages (which cannot read database settings).
SUPPORT_EMAIL=hello@{{DOMAIN}}

# --- Files & media -----------------------------------------------------------------------------------------------------
# local = storage/app/private (never web-reachable); public = storage/app/public behind /storage (storage:link).
FILESYSTEM_DISK=local
MEDIA_PUBLIC_DISK=public
MEDIA_PRIVATE_DISK=local
# Keep in step with Nginx client_max_body_size (64m) and PHP upload_max_filesize (12M) / post_max_size (64M).
MEDIA_MAX_UPLOAD_KB=10240
LEAD_ATTACHMENT_MAX_KB=10240
# Only for an S3-compatible disk (not used by default)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Security ----------------------------------------------------------------------------------------------------------
CSP_ENABLED=true
# true only for a first deploy behind a new CDN: violations are reported in the browser console, not blocked.
CSP_REPORT_ONLY=false
# Extra origins (comma-separated, https://…) when media or APIs are served from another host / CDN.
CSP_IMG_SRC=
CSP_CONNECT_SRC=
# Sent by Nginx in production; the app's own header is used when Nginx does not set one.
HSTS_MAX_AGE=31536000
CHECK_BREACHED_PASSWORDS=true
# Must stay false: the SSRF guard refuses private / loopback targets for webhooks and the SEO link checker.
ALLOW_PRIVATE_OUTBOUND=false
# Load balancer / CDN that connects to Nginx over plain HTTP: its IPs or CIDRs (comma-separated). Leave empty when
# Nginx terminates TLS itself or rewrites the client IP with set_real_ip_from (DEPLOYMENT_GUIDE §5.2).
TRUSTED_PROXIES=
AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users
# AUTH_MODEL=   (default App\Models\User)
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# Seconds before "confirm your password" is asked again (3 h).
AUTH_PASSWORD_TIMEOUT=10800
SANCTUM_STATEFUL_DOMAINS={{DOMAIN}}
# SANCTUM_TOKEN_PREFIX=

# --- Operations (M12) --------------------------------------------------------------------------------------------------
# CHANGE: random 40+ chars (openssl rand -hex 24). Monitors send it as X-Health-Token to see /health details.
HEALTH_TOKEN=
# Networks that see /health details without the token (CIDR allowed).
HEALTH_ALLOWED_IPS=127.0.0.1,::1
HEALTH_MAX_QUEUE_AGE=600
HEALTH_MIN_FREE_DISK_MB=2048

# --- Business defaults ---------------------------------------------------------------------------------------------------
# Search indexing is NOT an env var: Admin → Settings → SEO → "Search engine indexing". Unset = allowed only when
# APP_ENV=production; set it to "Allow" explicitly at go-live (app:check-production fails while it blocks).
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
AI_MONTHLY_BUDGET_USD=50
AI_TIMEOUT_SECONDS=30
ASSISTANT_RETENTION_DAYS=30
ASSISTANT_LEAD_RETENTION_DAYS=365
CHANGE_REQUEST_EXPIRY_DAYS=14
MCP_TOOL_CALL_RETENTION_DAYS=90
SUPPORT_AUTO_CLOSE_DAYS=7
SEO_AUDIT_MAX_PAGES=500
SEO_AUDIT_CHECK_EXTERNAL_LINKS=false
# Server time is UTC (config/app.php); the digest time is UTC too.
RADAR_DIGEST_TIME=08:00

# --- Provider endpoints (defaults are the official production APIs; change only for a sandbox / proxy) -----------------
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_API_VERSION=2024-06-20
PAYMOB_BASE_URL=https://accept.paymob.com
PAYTABS_EGY_URL=https://secure-egypt.paytabs.com
PAYTABS_SAU_URL=https://secure.paytabs.sa
PAYTABS_ARE_URL=https://secure.paytabs.com
PAYTABS_GLOBAL_URL=https://secure-global.paytabs.com
FAWRY_TEST_URL=https://atfawry.fawrystaging.com
FAWRY_LIVE_URL=https://www.atfawry.com
LINKEDIN_API_URL=https://api.linkedin.com
LINKEDIN_API_VERSION=202410
META_GRAPH_URL=https://graph.facebook.com
META_GRAPH_VERSION=v21.0
X_API_URL=https://api.x.com
FREELANCER_API_URL=https://www.freelancer.com/api
UPWORK_TOKEN_URL=https://www.upwork.com/api/v3/oauth2/token
UPWORK_GRAPHQL_URL=https://api.upwork.com/graphql
TELEGRAM_API_URL=https://api.telegram.org

# --- Frontend build ----------------------------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# --- Unused framework drivers (kept so the list is complete; leave empty) ---------------------------------------------
BROADCAST_CONNECTION=log
# BEANSTALKD_QUEUE_HOST=
# BEANSTALKD_QUEUE=
# BEANSTALKD_QUEUE_RETRY_AFTER=
# SQS_PREFIX=
# SQS_QUEUE=
# SQS_SUFFIX=
# DYNAMODB_CACHE_TABLE=
# DYNAMODB_ENDPOINT=
# MEMCACHED_HOST=
# MEMCACHED_PORT=
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# --- Local development only — must stay EMPTY in production (LocalDevAccountsSeeder refuses outside APP_ENV=local) ---
DEV_ADMIN_PASSWORD=
DEV_EDITOR_PASSWORD=
DEV_CLIENT_PASSWORD=
DEV_ADMIN_2FA_SECRET=
